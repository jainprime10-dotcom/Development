# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. Never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase PostgreSQL:
# Runtime URL: use the transaction pooler connection string for serverless hosting.
DATABASE_URL=

# Prisma CLI/migrations: use the session pooler or direct connection supported by your network.
DIRECT_URL=

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email provider (configure in a later sprint)
RESEND_API_KEY=
